{
  "name": "particle-life",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ecosistema 2D de partículas con matrices de atracción, simulado y renderizado íntegramente en GPU (WebGPU).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vite-node test/unit.ts",
    "test:gpu": "vite-node test/validate.ts",
    "test:browser": "node test/browser.mjs http://localhost:5173/",
    "test:all": "npm run typecheck && npm test && npm run test:gpu",
    "build:artifact": "npm run build:single && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "webgpu": "^0.6.2"
  },
  "license": "MIT",
  "keywords": [
    "particle-life",
    "webgpu",
    "simulation",
    "generative-art",
    "artificial-life"
  ]
}
